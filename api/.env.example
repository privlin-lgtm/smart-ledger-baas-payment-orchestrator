PORT=8787
SUPABASE_URL=https://vhkkulfwrvxucmkjeemj.supabase.co
# Service role (secret) key — from Supabase Dashboard > Project Settings > API.
# Server-side only. Never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Shared secret every /api request must send as the x-api-key header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
API_KEY=
# Max requests per IP per minute before a 429. The dashboard's own polling alone can
# approach 150/min while a payout is in flight, so keep real headroom above that.
RATE_LIMIT_MAX=600

# Simulated bank-rail settlement timing/outcome for the payout engine.
PAYOUT_SETTLEMENT_DELAY_MS_MIN=3000
PAYOUT_SETTLEMENT_DELAY_MS_MAX=8000
PAYOUT_FAILURE_RATE=0.15
