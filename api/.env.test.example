# Copy to api/.env.test for the integration tests (npm test --workspace=api).
# Point this at a DISPOSABLE Supabase project or branch with supabase/migrations applied.
# Tests write permanent append-only rows, so never use the demo or production project here.
# The test guard refuses to run if this file is missing or SUPABASE_URL is the demo project.
SUPABASE_URL=https://<test-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<test-project-service-role-key>
API_KEY=<any-test-api-key>
